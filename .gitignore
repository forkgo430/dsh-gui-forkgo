# dsh-gui-forkgo Git 忽略配置

# ── 依赖 ────────────────────────────────────────────────────────────────
node_modules/
package-lock.json
pnpm-lock.yaml
.npm/
.yarn/

# ── Python（本地分支的构建产物）─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
.python-version

# ── uvx / uv 缓存 ──────────────────────────────────────────────────────
.uv/
uv.lock

# ── 运行产物 ────────────────────────────────────────────────────────────
.dsh-pilot/
*.log
*.err
tmp/
temp/
.cache/

# ── 编辑器与 IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── 系统文件 ────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/

# ── 备份 / 临时 ─────────────────────────────────────────────────────────
*.bak
*.bak-*
*.orig
*.rej
*.patch.bak

# ── 其他 AI 助手的本地配置（不进库）─────────────────────────────────────
CLAUDE.md
.claude/
.cursor/
.aider*

# 用户全局 gitignore 里有 *.local.md（Qoder 的私有文件），会把 vendor 里那份
# README.local.md 一起挡掉。那份是包的一部分，记录本分支对上游改了什么，要进库。
!dsh-bundle/vendor/windows-mcp/README.local.md

# ── 本项目的发布产物 ────────────────────────────────────────────────────
*.tgz
*.zip
release/
