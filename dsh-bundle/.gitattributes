# 默认自动换行处理
* text=auto

# 文本文件统一 LF（仓库内），检出时按平台
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.svg     text eol=lf
*.ps1     text eol=crlf

# 二进制
*.png     binary
*.ico     binary
*.jpg     binary
*.woff    binary
*.woff2   binary
